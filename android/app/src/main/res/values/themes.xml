<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets what shows before
         the first frame. -->
    <style name="Theme.Replique" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <color name="background">#FFFBF8F3</color>
    <color name="ic_launcher_background">#FF1F3A5F</color>
</resources>
